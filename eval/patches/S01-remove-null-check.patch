Date: Sat, 26 Sep 2026 14:39:41 +0400
Subject: [PATCH] Refactor refund lookup (drop redundant existence check)

---
 app/api/payments.py | 3 ---
 1 file changed, 3 deletions(-)

diff --git a/app/api/payments.py b/app/api/payments.py
index 4b699ad..bd98ffd 100644
--- a/app/api/payments.py
+++ b/app/api/payments.py
@@ -64,9 +64,6 @@ def list_customer_payments(customer_id: str, db: Session = Depends(get_db)):
 @router.post("/payments/{payment_id}/refund", response_model=PaymentOut)
 def refund_payment(payment_id: str, reason: str = "", db: Session = Depends(get_db)):
     payment = db.get(Payment, payment_id)
-    if payment is None:
-        logger.warning("Payment not found: %s (reason: %s)", payment_id, reason)
-        raise HTTPException(status_code=404, detail="Payment not found")
     payment.status = "refunded"
     db.commit()
     db.refresh(payment)
