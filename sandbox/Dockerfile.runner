# Pre-built from the target repo's own dependencies (doc section 11.4) —
# no network needed at test/lint time, since everything is already installed
# into the image. Build context is the demo repo, same as its own Dockerfile.
FROM python:3.12-slim

RUN pip install --no-cache-dir uv

WORKDIR /work
COPY pyproject.toml ./
RUN uv pip install --system --no-cache -r pyproject.toml
RUN uv pip install --system --no-cache ruff pytest

# No CMD: the allowlisted command (pytest_all / pytest_file / ruff) is passed
# explicitly at `docker run` time by app/tools/sandbox.py — never free-form.
