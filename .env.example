AGENT_MODE=rca

LLM_PROVIDER=anthropic
LLM_MODEL_FAST=claude-sonnet-5
LLM_MODEL_STRONG=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Alternative: set LLM_PROVIDER=gateway to use an internal OpenAI-compatible
# gateway instead of calling Anthropic/OpenAI directly.
LLM_GATEWAY_URL=
LLM_GATEWAY_MODEL=
LLM_GATEWAY_MODEL_PREFIX=
LLM_GATEWAY_API_KEY=

GITHUB_TOKEN=
GITHUB_REPO=<owner>/demo-payment-service

SLACK_WEBHOOK_URL=

AGENT_DATABASE_URL=postgresql+psycopg://agent:agent@127.0.0.1:55432/agent

LOKI_URL=http://127.0.0.1:3100
TEMPO_URL=http://127.0.0.1:3200
PROMETHEUS_URL=http://127.0.0.1:9090
